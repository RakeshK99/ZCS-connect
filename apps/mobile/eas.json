    "production": { "extends": "base", "distribution": "store", "autoIncrement": true }
  },
  "submit": {
    "demo": { "ios": { "appleTeamId": "B8DZJ77GAH", "ascAppId": "6825599860" } },
    "production": {
      "ios": { "appleTeamId": "B8DZJ77GAH", "ascAppId": "6825599860" },
      "android": { "track": "internal", "releaseStatus": "draft" }
    }
  }
